# ========================================
# Math Teacher Bot - Environment Settings
# ========================================

# Telegram bot token
# Create a bot using BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API key
# Generate one here: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Default AI model
# Common options:
#   - llama-3.1-8b-instant   (fast, lightweight)
#   - llama-3.1-70b-versatile (larger, better reasoning)
GROQ_MODEL=llama-3.1-8b-instant

# Telegram bot username (without @)
BOT_USERNAME=your_bot_username

# Debug mode for verbose logging (True/False)
DEBUG_MODE=False

# Enable video/audio explanations (True/False)
ENABLE_VIDEO=True
